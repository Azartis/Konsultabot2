<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration: Block cleartext by default, allow HTTPS only -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust system certificates -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Allow ngrok domains with their SSL certificates -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">ngrok.io</domain>
        <domain includeSubdomains="true">ngrok-free.dev</domain>
        <domain includeSubdomains="true">ngrok.app</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    
    <!-- For development: Allow localhost (only in debug builds) -->
    <!-- Production APK will NOT allow HTTP/cleartext -->
</network-security-config>

